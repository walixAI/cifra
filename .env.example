# Cifra — variables de entorno
# Copia a .env y llena. Nada de esto se sube a git.

# ─── base de datos ───────────────────────────────────────────────
# Neon: la cadena con -pooler para la app, la directa para migraciones
DATABASE_URL="postgresql://usuario:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/cifra?sslmode=require"
DIRECT_URL="postgresql://usuario:pass@ep-xxx.us-east-2.aws.neon.tech/cifra?sslmode=require"

# ─── auth ────────────────────────────────────────────────────────
AUTH_SECRET=""                      # openssl rand -base64 32
AUTH_URL="http://localhost:3000"
# magic link por correo — API HTTP de Resend, no SMTP (las funciones serverless de Vercel no
# manejan bien SMTP). Sin AUTH_RESEND_KEY: en desarrollo el enlace se imprime en consola; en
# producción es un error explícito. Las invitaciones (paso 8) usan el mismo transporte.
AUTH_RESEND_KEY=""                   # re_... — Resend → API Keys
EMAIL_FROM="Cifra <hola@cifra.mx>"   # el dominio tiene que estar verificado en Resend

# ─── cifrado de credenciales fiscales ────────────────────────────
# La CIEC y la e.firma son la identidad fiscal del usuario. Ver §4 de ARQUITECTURA.md.
# v0: llave maestra local. Producción: KMS.
CREDENCIALES_LLAVE_MAESTRA=""        # 32 bytes en base64
# KMS_KEY_ID="arn:aws:kms:..."       # cuando migres

# ─── SAT ─────────────────────────────────────────────────────────
# En desarrollo y en CI, cliente falso que lee de datos/seed.json
SAT_MODO="falso"                     # falso | real
SAT_URL_DESCARGA=""
SAT_URL_VALIDACION=""
SAT_TIMEOUT_MS="120000"
SAT_MAX_INTENTOS="5"
SAT_CONCURRENCIA_POR_RFC="1"         # nunca más de una bajada simultánea por RFC

# ─── bancos ──────────────────────────────────────────────────────
BANCOS_MODO="falso"                  # falso | real
BANCOS_API_KEY=""
BANCOS_WEBHOOK_SECRET=""

# ─── trabajos (apps/trabajos: worker de Inngest, único que descifra la CIEC) ──
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
PUERTO_TRABAJOS="3100"               # el servidor Hono que expone /api/inngest

# ─── archivos (XML, PDF, acuses) ─────────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ─── IA ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
IA_MODELO="claude-sonnet-4-5"
# Toda respuesta debe citar su origen; si el enrutador no puede citar, no responde.
IA_EXIGIR_CITACIONES="true"

# ─── observabilidad ──────────────────────────────────────────────
SENTRY_DSN=""
AXIOM_TOKEN=""
AXIOM_DATASET="cifra"

# ─── varios ──────────────────────────────────────────────────────
TZ="America/Mexico_City"             # el SAT opera en hora del centro
NEXT_PUBLIC_APP_URL="http://localhost:3000"
