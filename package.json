{
  "name": "cifra",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @cifra/web dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @cifra/web start",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "build:verificar": "pnpm --filter @cifra/web build:verificar",
    "test": "pnpm -r --if-present test",
    "test:aislamiento": "pnpm --filter @cifra/db test",
    "test:core": "pnpm --filter @cifra/core test",
    "db:seed": "pnpm --filter @cifra/db db:seed",
    "db:studio": "pnpm --filter @cifra/db prisma:studio",
    "db:dev": "pnpm --filter @cifra/db db:dev"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@next/eslint-plugin-next": "15.5.25",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.69.0"
  }
}
