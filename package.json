{
  "name": "cifra",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @cifra/web dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @cifra/web start",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:seed": "pnpm --filter @cifra/db db:seed",
    "db:studio": "pnpm --filter @cifra/db prisma:studio",
    "db:dev": "pnpm --filter @cifra/db db:dev"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:"
  }
}
