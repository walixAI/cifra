{
  "name": "@cifra/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @cifra/db run prisma:generate && next build",
    "build:verificar": "pnpm --filter @cifra/db run prisma:generate && cross-env NEXT_DIST_DIR=.next-verificar next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cifra/core": "workspace:*",
    "@cifra/db": "workspace:*",
    "@cifra/ui": "workspace:*",
    "next": "^15.1.6",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "8.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@prisma/nextjs-monorepo-workaround-plugin": "6.19.3",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "catalog:"
  }
}
